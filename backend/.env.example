# Copy to backend/.env and fill in. Never commit the real .env.

# --- LangSmith (tracing of every chat turn; see docs/langsmith.md) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Agent-based workspace: traces go to this agent + environment (do NOT also set LANGSMITH_PROJECT).
LANGSMITH_AGENT_ID=langchain-rag-rca
LANGSMITH_AGENT_ENVIRONMENT=local

# --- LLM / embeddings (used from Phase 3-4) ---
GOOGLE_API_KEY=
# Copy the exact model ID from Google AI Studio; names change.
LLM_MODEL=gemini-3.5-flash
# Tried in order if the primary returns errors (503 "high demand" happens on new Flash models).
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the embedding model's output size. Fixed into the DB schema by the migration.
EMBEDDING_DIM=384

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://crtc:crtc@localhost:5433/crtc

# --- Auth ---
# Same Web OAuth client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Long random string (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Comma-separated emails allowed to log in. Empty = any Google account can log in.
ALLOWED_EMAILS=
# Exact origin of the frontend (used for CORS and the CSRF Origin check). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# --- Knowledge-base sync (Phase 3; every value below is optional, these are the defaults) ---
# Where downloaded originals are kept (git-ignored). Default: backend/data
# DATA_DIR=
# CRTC_MAX_DOCUMENT_BYTES=52428800
# KB_MAX_ZIP_ENTRIES=500
# KB_MAX_ZIP_UNCOMPRESSED_BYTES=314572800
# KB_MAX_ZIP_RATIO=100
# Parser sandbox: wall-clock timeout (s) and memory limit (MB; a Job object on Windows)
# KB_PARSE_TIMEOUT_S=90
# KB_PARSE_MEMORY_MB=1536
# Skip even the listing request if the case was synced this recently (s)
# KB_RECHECK_MIN_INTERVAL_S=300
# Don't re-ask a host that blocked a document sooner than this (s)
# KB_BLOCKED_RETRY_S=86400
# POST /cases/{id}/sync: per-user limit and window, and syncs allowed at once overall
# KB_SYNC_RATE_LIMIT=6
# KB_SYNC_RATE_WINDOW_S=600
# KB_MAX_CONCURRENT_SYNCS=2

# --- Agent / chat limits ---
# MAX_QUESTION_CHARS=2000
# CHAT_RATE_LIMIT=20            # messages per user per CHAT_RATE_WINDOW_S
# AGENT_RECURSION_LIMIT=60
# ROGERS_TERMS=Rogers,Rogers Communications,Rogers Wireless

# --- Scheduled knowledge-base refresh (or run `python -m app.cli refresh-all` from OS cron) ---
# REFRESH_CRON_ENABLED=true
# REFRESH_CRON_SCHEDULE=0 */6 * * *
# REFRESH_CASE_SCOPE=chatted    # cases referenced by at least one chat
